{
  "info": {
    "name": "Oficina — Saga (microsserviços)",
    "description": "Fluxo direto nos microsserviços. Execute a pasta na ordem. baseUrl=8000, billingUrl=8003, executionUrl=8002.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000" },
    { "key": "billingUrl", "value": "http://localhost:8003" },
    { "key": "executionUrl", "value": "http://localhost:8002" },
    { "key": "osUrl", "value": "http://localhost:8000" },
    { "key": "token", "value": "" },
    { "key": "clienteId", "value": "" },
    { "key": "veiculoId", "value": "" },
    { "key": "servicoId", "value": "" },
    { "key": "pecaId", "value": "" },
    { "key": "osId", "value": "" },
    { "key": "internalKey", "value": "dev-internal-key" }
  ],
  "item": [
    {
      "name": "Saga — fluxo feliz",
      "item": [
        {
          "name": "1 Login admin",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "if (pm.response.code === 200) {",
                "  pm.collectionVariables.set('token', pm.response.json().access_token);",
                "}"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@oficina.dev\",\n  \"senha\": \"admin123\"\n}" },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "1b Criar cliente",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "if (pm.response.code === 201 || pm.response.code === 200) {",
                "  pm.collectionVariables.set('clienteId', pm.response.json().id);",
                "}"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Maria Demo\",\n  \"contato\": \"maria@exemplo.com\",\n  \"cpf_cnpj\": \"52998224725\"\n}"
            },
            "url": "{{baseUrl}}/clientes"
          }
        },
        {
          "name": "1c Criar veículo",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "if (pm.response.code === 201 || pm.response.code === 200) {",
                "  pm.collectionVariables.set('veiculoId', pm.response.json().id);",
                "}"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cliente_id\": {{clienteId}},\n  \"placa\": \"ABC1234\",\n  \"marca\": \"Fiat\",\n  \"modelo\": \"Uno\",\n  \"ano\": 2015\n}"
            },
            "url": "{{baseUrl}}/veiculos"
          }
        },
        {
          "name": "1d Criar serviço",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "if (pm.response.code === 201 || pm.response.code === 200) {",
                "  pm.collectionVariables.set('servicoId', pm.response.json().id);",
                "}"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Troca de óleo\",\n  \"preco\": \"100.00\"\n}" },
            "url": "{{baseUrl}}/servicos"
          }
        },
        {
          "name": "1e Criar peça",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "if (pm.response.code === 201 || pm.response.code === 200) {",
                "  pm.collectionVariables.set('pecaId', pm.response.json().id);",
                "}"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Filtro de óleo\",\n  \"preco\": \"25.00\",\n  \"quantidade_estoque\": 10\n}"
            },
            "url": "{{baseUrl}}/pecas"
          }
        },
        {
          "name": "2 Criar OS",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "if (pm.response.code === 201) {",
                "  pm.collectionVariables.set('osId', pm.response.json().id);",
                "}"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cliente_id\": {{clienteId}},\n  \"veiculo_id\": {{veiculoId}},\n  \"servicos\": [{\"servico_id\": {{servicoId}}, \"quantidade\": 1}],\n  \"pecas\": [{\"peca_id\": {{pecaId}}, \"quantidade\": 1}]\n}"
            },
            "url": "{{baseUrl}}/os"
          }
        },
        {
          "name": "3 Aguardar orçamento (Billing)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const max = 15;",
                "let n = parseInt(pm.collectionVariables.get('budgetPoll') || '0', 10);",
                "if (pm.response.code === 404 && n < max) {",
                "  pm.collectionVariables.set('budgetPoll', String(n + 1));",
                "  setTimeout(function () {}, 2000);",
                "  postman.setNextRequest(pm.info.requestName);",
                "} else {",
                "  pm.collectionVariables.unset('budgetPoll');",
                "  pm.test('Orçamento criado pela Saga', function () { pm.expect(pm.response.code).to.eql(200); });",
                "}"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "GET",
            "url": "{{billingUrl}}/orcamentos/os/{{osId}}"
          }
        },
        {
          "name": "4 Aprovar orçamento",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"aprovado\": true\n}" },
            "url": "{{billingUrl}}/orcamentos/os/{{osId}}/decisao"
          }
        },
        {
          "name": "5 Simular pagamento aprovado",
          "request": {
            "method": "POST",
            "url": "{{billingUrl}}/orcamentos/os/{{osId}}/pagamento/simular-aprovado"
          }
        },
        {
          "name": "6 Consultar OS",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/os/{{osId}}"
          }
        }
      ]
    },
    {
      "name": "Saga — falha (billing indisponível)",
      "item": [
        {
          "name": "GET internal items (deve falhar se OS down)",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Internal-Service-Key", "value": "{{internalKey}}" }],
            "url": "{{osUrl}}/internal/os/{{osId}}/items"
          }
        }
      ]
    }
  ]
}
